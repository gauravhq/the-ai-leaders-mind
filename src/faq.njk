---
layout: base.njk
permalink: /faq/
title: FAQ
pageDescription: Answers to common questions about leading with AI - The AI Leader's Mind by Gaurav Srivastava. Judgment, trust, bias, ethics, resilience, and the human side of leading in an AI-driven world.
---
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{% for item in faqs.all %}{"@type":"Question","name":{{ item.q | dump | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ item.a | dump | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]}
</script>
<section class="section"><div class="wrap" style="max-width:860px">
  <div class="eyebrow">FAQ</div>
  <h1>Questions people ask about leading with AI</h1>
  <p class="lead">{{ faqs.all | length }} grounded answers drawn from <em>{{ site.title }}</em>, on judgment, trust, bias, empathy, fear, resilience, and ethics when a machine is in the room. Jump to a topic or browse the lot.</p>

  <nav class="faq-nav" aria-label="FAQ topics">
    {% for g in faqs.groups %}<a href="#{{ g.id }}">{{ g.category }}</a>{% endfor %}
  </nav>

  {% for g in faqs.groups %}
  <section class="faq-group" id="{{ g.id }}">
    <h2>{{ g.category }}</h2>
    {% for item in g.items %}
    <details class="faq">
      <summary>{{ item.q }}</summary>
      <div class="faq-a"><p>{{ item.a }}</p></div>
    </details>
    {% endfor %}
  </section>
  {% endfor %}

  <p class="faq-more" style="margin-top:28px"><a href="/book/">Read more about the book &rarr;</a>{% if site.amazon.kindle %} &nbsp;&middot;&nbsp; <a href="{{ site.amazon.kindle }}" target="_blank" rel="noopener">Get it on Kindle</a>{% endif %}</p>
</div></section>
