---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:content="http://purl.org/rss/1.0/modules/content/" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title }}: {{ site.subtitle }}</title>
    <link>{{ site.url }}/</link>
    <atom:link href="{{ site.url }}/feed.xml" rel="self" type="application/rss+xml"/>
    <description>{{ site.description }}</description>
    <language>en</language>
    <copyright>{{ site.author }}</copyright>
    {% if collections.posts.length %}<lastBuildDate>{{ collections.posts[0].date | rssDate }}</lastBuildDate>{% endif %}
    {% for post in collections.posts %}
    <item>
      <title>{{ post.data.title }}</title>
      <link>{{ site.url }}{{ post.url }}</link>
      <guid isPermaLink="true">{{ site.url }}{{ post.url }}</guid>
      <pubDate>{{ post.date | rssDate }}</pubDate>
      <description>{{ post.data.pageDescription }}</description>
      <content:encoded><![CDATA[{{ post.templateContent | safe }}<p>From <em>{{ site.title }}: {{ site.subtitle }}</em> by {{ site.author }}. <a href="{{ site.url }}{{ post.url }}">Read the original</a>.</p>]]></content:encoded>
    </item>
    {% endfor %}
  </channel>
</rss>
